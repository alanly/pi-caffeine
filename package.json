{
  "name": "pi-caffeine",
  "version": "0.1.0",
  "description": "Pi extension: hold a native OS wake assertion while the agent is working (macOS caffeinate, Linux systemd-inhibit, Windows SetThreadExecutionState), with a ☕ footer status.",
  "type": "module",
  "keywords": [
    "pi-package",
    "pi",
    "pi-coding-agent",
    "caffeinate",
    "wake-lock",
    "prevent-sleep"
  ],
  "license": "MIT",
  "scripts": {
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit"
  },
  "pi": {
    "extensions": [
      "./index.ts"
    ]
  },
  "peerDependencies": {
    "@earendil-works/pi-agent-core": "*",
    "@earendil-works/pi-ai": "*",
    "@earendil-works/pi-coding-agent": "*",
    "@earendil-works/pi-tui": "*"
  },
  "devDependencies": {
    "@types/node": "*",
    "typescript": "^7.0.2",
    "vitest": "^2.1.0"
  }
}
